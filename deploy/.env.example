# GHCR image coordinates
IMAGE_OWNER=pcwto
IMAGE_TAG=main
REGISTRY=ghcr.io

# API runtime
SERVER_PORT=8080
SERVER_MODE=release

# Supabase Postgres
# Use a pooled Supabase connection string when possible, and keep sslmode=require.
DATABASE_DRIVER=postgres
DATABASE_DSN=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Vercel frontend origins. The backend matches Origin values exactly.
# Include both production custom domains and any Vercel preview domains you intentionally allow.
CORS_ALLOWED_ORIGINS=https://your-shop.vercel.app,https://your-admin.vercel.app
CORS_ALLOWED_HEADERS=Content-Type,Content-Length,Accept,Accept-Encoding,Authorization,Cache-Control,X-Requested-With,X-CSRF-Token,X-Request-ID,X-Lang
CORS_ALLOW_CREDENTIALS=true

# Production secrets. Use different random values, at least 32 characters each.
APP_SECRET_KEY=replace-with-32-plus-random-characters
JWT_SECRET=replace-with-a-different-32-plus-random-secret
USER_JWT_SECRET=replace-with-another-32-plus-random-secret
DJ_DEFAULT_ADMIN_USERNAME=admin
DJ_DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Optional Redis / queue integration. Enable when automatic fulfillment/workers are deployed.
REDIS_ENABLED=false
QUEUE_ENABLED=false

# Optional email integration
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=

# Payment callback routes exposed by the public API reverse proxy.
# Configure Stripe/PayPal secrets in the admin console, not in this file.
STRIPE_WEBHOOK_URL=https://mmmslai.win/dujiao-next/api/v1/payments/webhook/stripe
PAYPAL_WEBHOOK_URL=https://mmmslai.win/dujiao-next/api/v1/payments/webhook/paypal
